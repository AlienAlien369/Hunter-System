# ===========================================
# Hunter System - Production Environment
# ===========================================
# Copy this to .env and update for production

# Database
POSTGRES_USER=hunter
POSTGRES_PASSWORD=CHANGE_THIS_STRONG_PASSWORD
POSTGRES_DB=hunter_system
DATABASE_PORT=5432

# Backend Database Connection
DB_HOST=postgres
DB_PORT=5432
DB_USER=hunter
DB_PASSWORD=CHANGE_THIS_STRONG_PASSWORD
DB_NAME=hunter_system

# JWT (CHANGE THIS TO A STRONG RANDOM SECRET)
JWT_SECRET=CHANGE_THIS_TO_A_VERY_LONG_RANDOM_STRING_32_CHARS_MIN

# Server Ports
BACKEND_PORT=3000
FRONTEND_PORT=80
NODE_ENV=production

# CORS - Set to your production domain
FRONTEND_URL=https://your-domain.com

# Frontend API URL (relative path for nginx proxy)
VITE_API_URL=/api

# Demo User (optional, for initial seeding)
DEMO_USER=demo_user
DEMO_PASS=CHANGE_THIS_PASSWORD
DEMO_NAME=Demo Hunter

# Adminer (only needed with --profile debug)
ADMINER_PORT=8080
