{
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/h/:name",
      "destination": "/api/profile-preview?name=:name"
    },
    {
      "source": "/in",
      "destination": "/in.html"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
